---
import { graphTools, barWorkflowTools } from '../../content/graphTools';
import { siteCreator } from '../../content/site';
import ContactLine from '../ui/ContactLine.astro';
---
<footer class="border-border bg-surface border-t py-10">
  <div class="page-shell grid gap-9 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div>
      <a aria-label="Graph Maker home" class="inline-flex items-center gap-2 text-xl font-bold tracking-tight" href="/">
        <img src="/images/graphmaker-header.webp" alt="GraphMaker" width="690" height="261" class="h-12 w-auto sm:h-14" loading="lazy" decoding="async" />
      </a>
      <p class="text-text-muted mt-3 max-w-xs text-sm leading-6">Turn your data into a clear, polished graph. Free to use, with no signup required.</p>
      <p class="text-text-muted mt-3 text-sm">Created by <a class="text-brand underline" href="/about/#creator">{siteCreator.name}</a>.</p>
      <ContactLine />
    </div>

    <nav aria-label="Graph tools">
      <h2 class="text-sm font-bold">Tools</h2>
      <ul class="text-text-muted mt-3 grid gap-2 text-sm">
        <li><a class="hover:text-brand" href="/tools/">All graph tools</a></li>
        {graphTools.map((tool) => <li>
          <a class="hover:text-brand" href={tool.href}>{tool.name}</a>
          {tool.type === 'bar' && <ul aria-label="Bar graph makers" class="border-border mt-2 ml-2 grid gap-2 border-l pl-3">
            {barWorkflowTools.map(child => <li><a class="hover:text-brand" href={child.href}>{child.name}</a></li>)}
          </ul>}
        </li>)}
      </ul>
    </nav>

    <nav aria-label="Resources">
      <h2 class="text-sm font-bold">Resources</h2>
      <ul class="text-text-muted mt-3 grid gap-2 text-sm">
        <li><a class="hover:text-brand" href="/about/">About</a></li>
      </ul>
    </nav>

    <nav aria-label="Legal">
      <h2 class="text-sm font-bold">Legal</h2>
      <ul class="text-text-muted mt-3 grid gap-2 text-sm">
        <li><a class="hover:text-brand" href="/privacy/">Privacy</a></li>
        <li><a class="hover:text-brand" href="/terms/">Terms</a></li>
        <li><button hidden data-privacy-open class="hover:text-brand text-left underline">Privacy and cookie settings</button></li>
      </ul>
    </nav>
  </div>
  <div class="page-shell border-border text-text-muted mt-9 border-t pt-6 text-sm">© 2026 GraphMaker. All rights reserved.</div>
</footer>
<dialog id="privacy-settings" aria-labelledby="privacy-heading" class="bg-surface text-text border-border m-auto max-h-[90vh] w-[calc(100%-2rem)] max-w-lg rounded-xl border p-6 shadow-xl backdrop:bg-black/40">
  <h2 id="privacy-heading" class="text-xl font-bold">Privacy and cookie settings</h2>
  <p data-privacy-status role="status" aria-live="polite" class="text-text-muted mt-4 leading-7">Analytics and advertising are paused while privacy settings load.</p>
  <p class="text-text-muted mt-3 leading-7">Use Google’s consent message to review available choices. You can also pause analytics and advertising on this device without deleting your saved graphs.</p>
  <div class="mt-5 flex flex-wrap gap-3">
    <button data-privacy-manage disabled class="border-border rounded-md border px-4 py-2 disabled:opacity-50">Manage Google consent</button>
    <button data-privacy-withdraw class="border-border rounded-md border px-4 py-2">Pause analytics and advertising</button>
    <button data-privacy-close class="bg-brand text-surface rounded-md px-4 py-2">Close</button>
  </div>
  <a class="text-brand mt-4 inline-block underline" href="/privacy/">Read our privacy policy</a>
</dialog>
