---
interface Props {
  hasEditor?: boolean;
  hasFaq?: boolean;
}

const { hasEditor = true, hasFaq = true } = Astro.props;
---

<header class="border-border bg-surface border-b">
  <div class="page-shell flex h-16 items-center justify-between gap-5">
    <a aria-label="Graph Maker home" class="flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight" href="/">
      <img src="/images/graphmaker-header.webp" alt="GraphMaker" width="690" height="261" class="h-12 w-auto sm:h-14" loading="eager" decoding="async" />
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-8 text-sm font-medium md:flex">
      <a class="hover:text-brand" href="/tools/">Graph Tools</a>
      <a class="hover:text-brand" href="/about/">About</a>
      {hasFaq && <a class="hover:text-brand" href="#faq">FAQ</a>}
    </nav>

    {hasEditor && <div class="hidden items-center gap-3 md:flex">
      <a class="text-text-muted hover:text-text inline-flex min-h-10 items-center gap-2 px-2 text-sm font-medium" href="#editor">
        <span aria-hidden="true">♡</span> Saved
      </a>
      <a class="button-primary" href="#data-editor">Create graph</a>
    </div>}

    <details class="relative md:hidden">
      <summary class="border-border flex min-h-10 cursor-pointer list-none items-center rounded-md border px-3 text-sm font-semibold">Menu</summary>
      <nav aria-label="Mobile navigation" class="border-border bg-surface shadow-editor absolute top-12 right-0 z-20 grid min-w-48 gap-1 rounded-md border p-2 text-sm font-medium">
        <a class="hover:bg-surface-subtle rounded px-3 py-2" href="/tools/">Graph Tools</a>
        <a class="hover:bg-surface-subtle rounded px-3 py-2" href="/about/">About</a>
        {hasFaq && <a class="hover:bg-surface-subtle rounded px-3 py-2" href="#faq">FAQ</a>}
        {hasEditor && <a class="bg-brand text-surface mt-1 rounded px-3 py-2 text-center" href="#data-editor">Create graph</a>}
      </nav>
    </details>
  </div>
</header>
