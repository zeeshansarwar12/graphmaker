---
import { treeTemplates, createTreeTemplateData } from '../../content/treeTemplates';
import { createTreeData } from '../../graph/transforms/tree';
import type { TreeNode } from '../../graph/transforms/tree';

function preview(template: typeof treeTemplates[number]) {
  const tree = createTreeData(createTreeTemplateData(template));
  const nodes: Array<{ id: string; parent: string; x: number; y: number }> = [];
  if (tree.status !== 'ready') return nodes;
  let leaf = 0;
  function place(node: TreeNode, parent: string, depth: number): number {
    const children = node.children.map(child => place(child, node.id, depth + 1));
    const x = children.length ? children.reduce((sum, value) => sum + value, 0) / children.length : leaf++;
    nodes.push({ id: node.id, parent, x, y: depth });
    return x;
  }
  place(tree.root, '', 0);
  return nodes.map(node => ({ ...node, x: 24 + node.x * 272 / Math.max(1, leaf - 1), y: 18 + node.y * 96 / Math.max(1, tree.levels - 1) }));
}
---
<section class="page-shell py-12 sm:py-14" aria-labelledby="tree-templates-heading" id="tree-templates">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="section-heading" id="tree-templates-heading">Tree diagram templates</h2>
    <p class="text-text-muted mt-3 leading-7">Create a tree diagram from an editable example. Choose a template to open a new diagram, then customize its labels and branches. Your current work stays available in My diagrams.</p>
  </div>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {treeTemplates.map(template => {
      const nodes = preview(template);
      return <article id={`tree-template-${template.id}`} class="border-border flex min-w-0 flex-col rounded-lg border bg-white p-5">
        <svg aria-hidden="true" class="bg-brand-soft mb-4 h-32 w-full rounded-md" viewBox="0 0 320 132" fill="none">
          {nodes.filter(node => node.parent).map(node => {
            const parent = nodes.find(candidate => candidate.id === node.parent)!;
            return <path d={`M${parent.x},${parent.y + 6}V${(parent.y + node.y) / 2}H${node.x}V${node.y - 6}`} stroke="#2563eb" stroke-width="1.5" />;
          })}
          {nodes.map(node => <rect x={node.x - 15} y={node.y - 6} width="30" height="12" rx="3" fill="white" stroke="#2563eb" stroke-width="1.5" />)}
        </svg>
        <h3 class="text-lg font-bold">{template.name}</h3>
        <p class="text-text-muted mt-2 flex-1 text-sm leading-6">{template.description}</p>
        <p class="text-text-muted mt-3 text-xs">{template.rows.length} editable nodes</p>
        <a class="button-secondary mt-4 justify-center" href={`/tree-graph-maker/#tree-template-${template.id}`}>Use {template.name.toLowerCase()} template</a>
      </article>;
    })}
  </div>
  <p class="text-text-muted mx-auto mt-5 max-w-3xl text-center text-sm leading-6">Decision outlines show choices as node labels. These templates do not calculate probabilities or model multiple-parent family relationships.</p>
</section>
