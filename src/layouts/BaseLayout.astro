---
import '../styles/global.css';
import { normalizeGoogleAnalyticsId } from '../lib/analytics/googleAnalytics';

interface Props {
  canonical?: string;
  title: string;
  description: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  canonical,
  title,
  description,
  robots = 'index,follow',
  structuredData,
} = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, Astro.site ?? Astro.url).href : undefined;
const googleAnalyticsId = normalizeGoogleAnalyticsId(import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID)
  ?? 'G-JM5S5JGFJJ';
const googleAnalyticsBootstrap = googleAnalyticsId
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(googleAnalyticsId)}, {
  allow_ad_personalization_signals: false,
  allow_google_signals: false,
  anonymize_ip: true
});`
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="r9NYNACi391MLcXqqUd0w48ayLHu3l1TZ4zuUJO6dEY" />
    <meta name="msvalidate.01" content="ADA32A2FC73ADC93B80B1231531C0854" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="viewport" content="width=device-width" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2214%22>📊</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {googleAnalyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(googleAnalyticsId)}`}></script>}
    {googleAnalyticsBootstrap && <script is:inline set:html={googleAnalyticsBootstrap}></script>}
    <title>{title}</title>
  </head>
  <body>
    <a class="bg-brand text-surface focus:top-3 fixed -top-20 left-3 z-50 rounded-md px-4 py-2 font-semibold" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
