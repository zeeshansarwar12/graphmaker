---
import SiteFooter from '../components/navigation/SiteFooter.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { allGraphTools } from '../content/graphTools';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import { pageBreadcrumbs } from '../content/seo';
const breadcrumbs = pageBreadcrumbs('About', '/about/');
---

<BaseLayout
  canonical="/about/"
  breadcrumbs={breadcrumbs}
  title="About GraphMaker — Fast, Private Graph Creation"
  description="Learn how GraphMaker helps people turn spreadsheet data into clear charts quickly, without an account and with data processed in the browser."
>
  <SiteHeader hasEditor={false} hasFaq={false} />
  <main class="page-shell max-w-4xl py-10 sm:py-14" id="main-content">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="mt-7 text-3xl font-bold tracking-tight sm:text-4xl">About GraphMaker</h1>
    <p class="text-text-muted mt-4 text-lg leading-8">GraphMaker is a fast, privacy-first graphing workspace for turning small tables and spreadsheet data into polished charts.</p>
    <section class="mt-10" aria-labelledby="purpose-heading"><h2 class="section-heading" id="purpose-heading">Built for a practical job</h2><p class="text-text-muted mt-3 leading-7">The product focuses on the shortest path from data to a usable graph: enter or import a table, choose the right chart, make focused adjustments, and export the result.</p></section>
    <section class="mt-9" aria-labelledby="privacy-heading"><h2 class="section-heading" id="privacy-heading">Private by design</h2><p class="text-text-muted mt-3 leading-7">Graph data is processed in the browser. Projects can be saved locally on the same device or exported as project files without creating an account.</p></section>
    <section class="mt-9" aria-labelledby="shared-heading"><h2 class="section-heading" id="shared-heading">One consistent editor</h2><p class="text-text-muted mt-3 leading-7">Every graph maker uses the same editor foundation, with data guidance suited to its graph type.</p><ul class="mt-4 grid gap-2 sm:grid-cols-2">{allGraphTools.map((tool) => <li><a class="text-brand hover:underline" href={tool.href}>{tool.name}</a></li>)}</ul><a class="button-primary mt-5" href="/tools/">Browse graph tools</a></section>
  </main>
  <SiteFooter />
</BaseLayout>
