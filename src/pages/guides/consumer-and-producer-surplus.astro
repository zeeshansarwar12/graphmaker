---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import SiteFooter from '../../components/navigation/SiteFooter.astro';
import { siteCreator } from '../../content/site';
import { pageLastModified } from '../../content/pageLastModified';
import {
  exampleMarket as market, practiceMarket as practice, formatSurplus as f,
  scenarioNames, surplusChart, surplusGuideRoute, surplusScenarios, surplusSocialAlt, surplusSocialImage,
} from '../../content/guides/surplusExamples';

const tool = '/supply-and-demand-graph-maker/';
const h1 = 'Consumer and Producer Surplus on a Supply and Demand Graph';
const title = 'Consumer and Producer Surplus Graph Explained | GraphMaker';
const description = 'Learn to shade consumer and producer surplus and calculate how price ceilings, floors, and taxes change total surplus and deadweight loss.';
const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Supply and Demand Graph Maker', href: tool }, { name: 'Consumer and Producer Surplus', href: surplusGuideRoute }];
const base = Astro.site ?? Astro.url;
const date = pageLastModified[surplusGuideRoute];
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: h1, description,
  datePublished: date, dateModified: date,
  mainEntityOfPage: new URL(surplusGuideRoute, base).href,
  author: {
    '@type': 'Person',
    '@id': new URL('/about/#creator', base).href,
    name: siteCreator.name,
    url: new URL('/about/', base).href,
  },
  publisher: {
    '@type': 'Organization',
    '@id': new URL('/#organization', base).href,
    name: 'GraphMaker',
    url: new URL('/', base).href,
    logo: { '@type': 'ImageObject', url: new URL('/images/graphmaker-logo.svg', base).href },
  },
  image: new URL(surplusSocialImage, base).href,
};
const equation = ({ market: m }: typeof market) => `Qd = ${m.demandIntercept} − ${m.demandSlope}P, Qs = ${m.supplySlope}P − ${Math.abs(m.supplyIntercept)}`;
const area = (width: number, heights: readonly [number, number]) => `${f(width)} × (${heights.map(f).join(' + ')}) ÷ 2`;
const money = (value: number) => `$${f(value)}`;
const { equilibrium, ceiling, floor, tax } = market;
const practiceQuestions = [
  { question: 'Find the competitive price, quantity, and both surplus areas.', answer: `The price is ${money(practice.price)} and ${f(practice.quantity)} units trade. CS = ${area(practice.quantity, practice.equilibrium.consumerHeights)} = ${money(practice.equilibrium.consumer)}. PS = ${area(practice.quantity, practice.equilibrium.producerHeights)} = ${money(practice.equilibrium.producer)}.` },
  { question: `At a ${money(practice.market.ceiling)} ceiling, what is the shortage and how much surplus is lost?`, answer: `The shortage is ${f(practice.ceilingDemand)} − ${f(practice.ceilingSupply)} = ${f(practice.shortage)} units. DWL = ${area(practice.ceiling.missingTrades, [practice.ceiling.lossHeight, 0])} = ${money(practice.ceiling.loss)}.` },
  { question: `At a ${money(practice.market.floor)} floor, how many units go unsold and what is seller surplus?`, answer: `Excess supply is ${f(practice.floorSupply)} − ${f(practice.floorDemand)} = ${f(practice.excess)} units. With the lowest-cost sellers trading, PS = ${area(practice.floor.traded, practice.floor.producerHeights)} = ${money(practice.floor.producer)}.` },
  { question: `With a ${money(practice.market.tax)} per-unit tax, what prices do buyers and sellers face, and who pays more?`, answer: `Buyers pay ${money(practice.tax.buyer)} and sellers keep ${money(practice.tax.seller)}. Buyers bear ${money(practice.taxBurden.buyer)} per unit and sellers bear ${money(practice.taxBurden.seller)}. Revenue is ${money(practice.tax.revenue)}, and DWL is ${money(practice.tax.loss)}.` },
];
const figureAlts = {
  equilibrium: 'Demand and supply meet at the competitive quantity. Consumer surplus above the market price and producer surplus below it are shaded.',
  ceiling: 'A ceiling below equilibrium limits trade to quantity supplied. Consumer and producer surplus end at that quantity, and deadweight loss fills the gap between the curves up to equilibrium.',
  floor: 'A floor above equilibrium limits trade to quantity demanded. The chart marks unsold supply and shades consumer surplus, producer surplus, and deadweight loss.',
  tax: 'The buyer price is above the seller price. The rectangle between those prices represents tax revenue, and the triangle to its right represents deadweight loss.',
};
---
<BaseLayout {title} {description} canonical={surplusGuideRoute} {breadcrumbs} structuredData={article} socialImage={surplusSocialImage} socialImageAlt={surplusSocialAlt}>
  <SiteHeader hasEditor={false} hasFaq={false} />
  <main id="main-content" class="page-shell py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />
    <article class="mx-auto mt-8 max-w-3xl space-y-9 leading-7">
      <header>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{h1}</h1>
        <p class="mt-4">A ticket buyer who was willing to pay more than the ticket price gains from the purchase. A seller who would have accepted less gains too. A surplus graph adds up those gains across a market. It also shows what changes when a price rule or tax prevents some trades.</p>
        <p class="mt-3">For background, see <a href={tool + '#equilibrium'}>how to find equilibrium</a>, <a href={tool + '#supply-quick-help'}>how to read the axes</a>, and <a href={tool + '#supply-shift-guide'}>what shifts a curve</a> in the graph maker.</p>
      </header>
      <section>
        <h2>Where to shade consumer and producer surplus</h2>
        <p>Consumer surplus (CS) is what buyers were willing to pay minus what they actually paid. For each unit sold, the demand curve gives the buyer’s willingness to pay. Shade the area below demand and above the price buyers pay, stopping at the quantity actually traded.</p>
        <p>Producer surplus (PS) is what sellers receive minus the minimum they would accept for the units they sold. Each point on the supply curve gives the cost of supplying that unit in this model. Shade above supply and below the price sellers receive. Producer surplus measures gains above variable costs. A business may still have fixed costs to cover.</p>
        <p>The horizontal width of a shaded region is measured in units. Its height is measured in dollars per unit, so the area is in dollars. When the height falls linearly to zero, use a triangle. If both ends have a positive height, use a trapezoid by multiplying the width by the average of the two heights.</p>
      </section>
      {surplusScenarios.map(key => {
        const result = market[key];
        return <section>
          <h2>{scenarioNames[key]}</h2>
          {key === 'equilibrium' && <>
            <p>Consider a market for tickets to a school event, with price P in dollars and quantity in tickets. Suppose <strong>{equation(market)}</strong>. The highest willingness to pay is {money(market.demandPrice(0))}, and the supply curve begins at {money(market.supplyPrice(0))}.</p>
            <p>Setting demand equal to supply gives P = ({market.market.demandIntercept} + {Math.abs(market.market.supplyIntercept)}) ÷ ({market.market.demandSlope} + {market.market.supplySlope}) = <strong>{money(market.price)}</strong>. Substituting gives Q = {market.market.demandIntercept} − {market.market.demandSlope} × {market.price} = <strong>{market.quantity} tickets</strong>.</p>
            <p>The consumer triangle is {market.quantity} × ({f(market.demandPrice(0))} − {f(market.price)}) ÷ 2 = {money(equilibrium.consumer)}. The producer triangle is {market.quantity} × ({f(market.price)} − {f(market.supplyPrice(0))}) ÷ 2 = {money(equilibrium.producer)}. Their sum is <strong>{money(equilibrium.total)}</strong>.</p>
            <p>At the last ticket sold, willingness to pay and the cost of supplying the ticket are equal. Earlier tickets create positive gains. That shrinking gap explains why both shaded areas taper to a point.</p>
          </>}
          {key === 'ceiling' && <>
            <p>Set a maximum price of <strong>{money(ceiling.buyer)}</strong>. Buyers want {market.ceilingDemand} tickets, but sellers offer {market.ceilingSupply}. The shortage is {market.ceilingDemand} − {market.ceilingSupply} = <strong>{market.shortage} tickets</strong>. Assume the buyers willing to pay the most get the available tickets, with no waiting costs or resale.</p>
            <p>At the last ticket sold, the buyer’s willingness to pay is {money(ceiling.demandAtTraded)}. That leaves a positive height above the ceiling at the right edge of the blue area. Consumer surplus is a trapezoid. Seller surplus is a triangle because the cost of the last ticket equals the ceiling.</p>
            <p>Some buyers who still get tickets gain from the lower price. Buyers shut out of the market lose the chance to trade. That is why a lower price on its own cannot tell you whether buyers as a group gain. If tickets go to buyers by lottery or queue, the result can differ from this example.</p>
          </>}
          {key === 'floor' && <>
            <p>Set a minimum price of <strong>{money(floor.buyer)}</strong>. Sellers offer {market.floorSupply} tickets, and buyers want {market.floorDemand}. The excess supply is {market.floorSupply} − {market.floorDemand} = <strong>{market.excess} tickets</strong>. Assume the lowest-cost sellers make the sales and nobody buys the excess.</p>
            <p>At the last ticket sold, the producer’s cost is {money(floor.supplyAtTraded)}, below the floor, so the green area ends with positive height. Producer surplus is a trapezoid. Consumer surplus is a triangle because the last buyer’s willingness to pay equals the floor.</p>
            <p>A higher price helps the sellers who still make a sale, while others sell nothing. The graph counts gains from actual sales. If a government bought the unsold tickets, its spending and any value from those purchases would need to be included in a different calculation.</p>
          </>}
          {key === 'tax' && <>
            <p>Now remove the price rules and charge <strong>{money(market.market.tax)} per ticket</strong>. The buyer price equals the seller price plus the tax. Substituting that relationship into the demand equation and setting it equal to supply gives a seller price of {money(tax.seller)}, a buyer price of {money(tax.buyer)}, and {tax.traded} tickets sold.</p>
            <p>The buyer price rose by {money(market.taxBurden.buyer)} from the original price, and the seller price fell by {money(market.taxBurden.seller)}. Buyers bear {f(market.taxBurden.buyerShare * 100)}% of the tax per unit and sellers bear {f(market.taxBurden.sellerShare * 100)}%. This follows from the prices each side faces even if one side sends the entire tax payment to the government.</p>
            <p>Tax revenue is the rectangle between the two prices, {tax.traded} × {money(market.market.tax)} = <strong>{money(tax.revenue)}</strong>. Its width covers every unit still traded. The triangle of forgone gains begins where that rectangle ends.</p>
          </>}
          {key !== 'equilibrium' && <>
            <p>CS = {area(result.traded, result.consumerHeights)} = <strong>{money(result.consumer)}</strong>. PS = {area(result.traded, result.producerHeights)} = <strong>{money(result.producer)}</strong>. The deadweight loss (DWL) triangle runs from {result.traded} to {market.quantity} tickets. Its area is {area(result.missingTrades, [result.lossHeight, 0])} = <strong>{money(result.loss)}</strong>.</p>
          </>}
          <figure>
            <img src={surplusChart(key)} width="800" height="500" loading="lazy" alt={figureAlts[key]} />
          </figure>
          <p><a href={tool + '#editor'}>Make this graph</a> in the Supply and Demand Graph Maker. Open Generate from linear equations and enter the market equations to plot the curves, then use the shaded example as a reference.</p>
        </section>;
      })}
      <section>
        <h2>Compare the four outcomes</h2>
        <p>Total surplus adds consumer and producer surplus plus government revenue. Deadweight loss tells you how far that total falls below the competitive result. Add it back as a check against the original total in each row. Payments transferred between people affect who gains, while lost trades shrink the total.</p>
        <div class="overflow-x-auto"><table class="w-full border-collapse text-sm">
          <thead><tr>{['Scenario', 'CS', 'PS', 'Revenue', 'DWL', 'Total surplus'].map(label => <th class="border-border border-b p-2 text-left" scope="col">{label}</th>)}</tr></thead>
          <tbody>{surplusScenarios.map(key => <tr>
            <th class="border-border border-b p-2 text-left" scope="row">{scenarioNames[key]}</th>
            {[market[key].consumer, market[key].producer, market[key].revenue, market[key].loss, market[key].total].map(value => <td class="border-border border-b p-2">{money(value)}</td>)}
          </tr>)}</tbody>
        </table></div>
      </section>
      <section>
        <h2>Common mistakes when shading surplus</h2>
        <ul class="list-disc space-y-2 pl-6">
          <li><strong>Use the actual quantity traded.</strong> A ceiling can make buyers want more than sellers offer. A floor can make sellers offer more than buyers want. End the surplus areas at the smaller quantity.</li>
          <li><strong>Use the price each side faces.</strong> With a tax, measure buyer surplus above the buyer price and seller surplus below the seller price. Using one price for both puts some of the revenue rectangle into private surplus.</li>
          <li><strong>Start DWL at the last unit traded.</strong> The triangle is between the curves on the side toward the original equilibrium quantity. Shading to the left would include units that still sell.</li>
          <li><strong>Check the shape before using a formula.</strong> A surplus area can have a nonzero height at both ends. The triangle shortcut only works when one end reaches zero.</li>
        </ul>
      </section>
      <section>
        <h2>Practice with a different market</h2>
        <p>Use <strong>{equation(practice)}</strong> for a market for notebooks. Start from the competitive graph, then apply each policy separately. Use the same buyer and seller selection assumptions as in the ticket examples. Sketch the shaded areas before opening the answers.</p>
        <figure><img src={surplusChart('practice')} width="800" height="500" loading="lazy" alt="Supply and demand for the notebook practice market, with competitive equilibrium and the two surplus areas marked." /></figure>
        <ol class="list-decimal space-y-3 pl-6">{practiceQuestions.map(({ question, answer }) => <li><details class="border-border rounded-md border p-3"><summary class="cursor-pointer font-semibold">{question}</summary><p>{answer}</p></details></li>)}</ol>
        <p><a href={tool + '#editor'}>Make this graph</a> in the Supply and Demand Graph Maker and check how your curves compare with the practice chart.</p>
      </section>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  article h2 { font-size: 1.5rem; font-weight: 700; line-height: 1.3; margin-bottom: .75rem; }
  article section p + p, figure, figure + p, table, ol { margin-top: .85rem; }
  article a { color: var(--color-brand); text-decoration: underline; }
  figure img { width: 100%; height: auto; }
</style>
