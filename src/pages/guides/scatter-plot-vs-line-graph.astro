---
import CoordinateDiagram from '../../components/seo/CoordinateDiagram.astro';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import SiteFooter from '../../components/navigation/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const points: Array<[number, number]> = [[1, 15], [2, 18], [4, 16], [7, 23]];
const charts = [
  { title: 'Scatter plot', connect: false, explanation: 'Separate points show the association between day and temperature. Look at the overall pattern and how far individual observations sit from it.', href: '/scatter-plot-maker/', action: 'Open Scatter Plot Maker' },
  { title: 'Line graph', connect: true, explanation: 'Segments join readings in chronological order to show when temperature rose or fell. The longer gap from day 4 to day 7 represents three days between readings.', href: '/line-graph-maker/', action: 'Open Line Graph Maker' },
];
---
<BaseLayout title="Scatter Plot vs. Line Graph: When to Use Each | GraphMaker" description="Compare a scatter plot and a line graph drawn from the same measurements. See when to leave points separate, connect them, or add a line of best fit." canonical="/guides/scatter-plot-vs-line-graph/">
  <SiteHeader />
  <main class="page-shell py-12 sm:py-16" id="main-content">
    <article class="mx-auto max-w-5xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Scatter Plot vs. Line Graph</h1>
      <p class="text-text-muted mt-4 max-w-3xl leading-7">Use a scatter plot to examine the relationship between two numeric variables. Use a line graph when the order of the observations matters, such as readings over time.</p>
      <h2 class="section-heading mt-10">The same temperature readings drawn two ways</h2>
      <p class="text-text-muted mt-3 leading-7">Temperatures were 15°C on day 1, 18°C on day 2, 16°C on day 4, and 23°C on day 7. Both diagrams preserve the gaps between measurement days.</p>
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        {charts.map(chart => (
          <section class="border-border rounded-lg border p-5">
            <h3 class="text-xl font-bold">{chart.title}</h3>
            <CoordinateDiagram label={chart.connect ? 'Four temperature readings connected in day order' : 'Four separate temperature readings plotted by day'} points={points} connect={chart.connect} xRange={[0, 8]} yRange={[10, 25]} xLabel="Measurement day" yLabel="Temperature (°C)" />
            <p class="text-text-muted leading-7">{chart.explanation}</p>
            <a class="text-brand mt-3 inline-block underline" href={chart.href}>{chart.action}</a>
          </section>
        ))}
      </div>
      <h2 class="section-heading mt-10">When to use a line of best fit</h2>
      <p class="text-text-muted mt-3 leading-7">A line of best fit summarizes the overall linear relationship across points. The fitted line can pass between the observations and is useful when you want an equation and a measure of fit. A line graph joins the recorded observations in order so you can follow each change.</p>
      <h2 class="section-heading mt-8">How to handle uneven time intervals</h2>
      <p class="text-text-muted mt-3 leading-7">For the example above, use the <a class="text-brand underline" href="/xy-graph-maker/">XY Graph Maker</a> with measurement day as numeric X and Connect points on. That preserves the unequal gaps. Use the Line Graph Maker for evenly spaced periods or when categories are meant to have equal visual spacing.</p>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>