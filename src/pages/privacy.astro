---
import SiteFooter from '../components/navigation/SiteFooter.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLine from '../components/ui/ContactLine.astro';
import { legalLastUpdated } from '../content/site';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import { pageBreadcrumbs } from '../content/seo';
const breadcrumbs = pageBreadcrumbs('Privacy', '/privacy/');
---

<BaseLayout canonical="/privacy/" title="Privacy | GraphMaker" description="How GraphMaker handles graph data in the browser." robots="noindex,follow" breadcrumbs={breadcrumbs}>
  <SiteHeader hasEditor={false} hasFaq={false} />
  <main class="page-shell max-w-4xl py-10 sm:py-14" id="main-content">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Privacy</h1>
    {legalLastUpdated && <p class="text-text-muted mt-3 text-sm">Last updated: {legalLastUpdated}</p>}
    <p class="text-text-muted mt-4 leading-7">GraphMaker’s editor processes pasted and uploaded graph data in your browser. The application does not require an account or cloud database.</p>
    <h2 class="section-heading mt-9">Local projects</h2><p class="text-text-muted mt-3 leading-7">When you choose Save locally, the project is stored in IndexedDB on that device. Clearing browser storage can remove locally saved projects.</p>
    <h2 class="section-heading mt-9">Project files and exports</h2><p class="text-text-muted mt-3 leading-7">Files you import are read by the browser. Graph images, data exports, and project files are downloaded directly to your device.</p>
    <h2 class="section-heading mt-9">Usage analytics</h2><p class="text-text-muted mt-3 leading-7">Google Analytics records page visits and general browser, device, and referral information. GraphMaker does not send spreadsheet cells, graph values, uploaded-file contents, project names, or exported data to Google Analytics. Advertising personalization and Google signals are disabled.</p>
    <p class="text-text-muted mt-3 leading-7">Google Analytics may set cookies or similar identifiers to measure visits and distinguish browsers. These page-visit measurements are separate from your graph data, which is never sent to a GraphMaker server. The analytics script loads when a page opens.</p>
    <ContactLine />
  </main>
  <SiteFooter />
</BaseLayout>
